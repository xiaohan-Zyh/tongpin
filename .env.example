# 环境变量模板 —— 复制为 .env.local 后填入真实值
# 线上部署时，在 Vercel 项目的 Settings → Environment Variables 配置同名变量。

# 知乎开放平台 Access Secret（调用热榜、我的创作等接口所需）
ZHIHU_ACCESS_SECRET=

# 赛事页面分配的 OAuth 应用凭据
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# OAuth 回调地址，必须与赛事页面登记值逐字符一致
# 本地：http://localhost:3000/api/auth/callback
# 线上：https://<your-app>.vercel.app/api/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# 会话 Cookie 签名密钥，生产环境必须为随机长字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
